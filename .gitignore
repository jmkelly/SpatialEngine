# --- .NET ---
bin/
obj/
artifacts/
*.user
*.suo
TestResults/
.verify-scoped.slnx
.verify-test-results/

# --- Node ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# --- Editors / OS ---
.vs/
.vscode/
.idea/
.DS_Store
*.swp

# --- Local config (never commit) ---
.env
*.local.json
appsettings.Local.json

# --- Runtime publication registry (written by the host, ADR-0041) ---
data/

# --- Aspire (generated on first `dotnet run` of src/Spatial.AppHost) ---
aspire.config.json
.aspire/
# --- Quality-loop audit artifacts (regenerated by each audit run) ---
crap-queue.md
crap-report.json
coverage-queue.md
coverage-report.json
coverage-history.csv
metrics-queue.md
metrics-report.json
warnings-queue.md
warnings-report.json
stryker-queue.md
StrykerOutput/
doc-queue.md
doc-report.json

# --- Playwright browser test artifacts ---
test-results/
playwright-report/

# --- Local development task queue (beads; lives in the git common dir) ---
.beads/
.beads.gate.lock
# Retired spatial-tasks SQLite queue, kept ignored in case a stale worktree
# still resolves one.
.spatial-tasks/
*.tasks.db
*.tasks.db-wal
*.tasks.db-shm
# Playwright CLI output (may contain credentials)
.playwright-cli/

# Beads / Dolt files (added by bd init)
# .beads/ is already ignored above; the embedded Dolt store lives inside it.
.dolt/
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Python bytecode (tools/ scripts and their tests)
__pycache__/
*.py[co]
