<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Recorded real QGIS 4.2.2 WMS traffic (T-013). -->
    <Content Include="..\..\fixtures\qgis\*.json">
      <Link>qgis-fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Esri-docs parity replay corpus, GeometryServer slice (T-064). -->
    <Content Include="..\..\fixtures\esri-docs\**\*.json">
      <Link>esri-docs-fixtures\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The suite's collection parallelism, generated at build time (ADR-0196):
       the first host boot in a process is 13s of CPU-bound work and xunit
       paying a dozen of them at once is what starves the box. A fixed number
       cannot sit below nproc on every box — a shipped 4 fails the ceiling on
       anything under twelve cores — so no static file is carried: the build
       writes xunit.runner.json beside the test assembly with this machine's
       ceiling, max(2, nproc/3), and TestParallelismTests pins the agreement. -->
  <PropertyGroup>
    <_HostTestCores Condition="'$(_HostTestCores)' == ''">$([System.Environment]::ProcessorCount)</_HostTestCores>
    <_HostTestCap>$([System.Math]::Max(2, $([System.Math]::Floor($([MSBuild]::Divide($(_HostTestCores), 3))))))</_HostTestCap>
  </PropertyGroup>
  <Target Name="GenerateXunitRunnerConfig" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(TargetDir)" Condition="!Exists('$(TargetDir)')" />
    <WriteLinesToFile File="$(TargetDir)xunit.runner.json" Overwrite="true"
                      Lines='{&quot;$schema&quot;: &quot;https://xunit.net/schema/current/xunit.runner.schema.json&quot;, &quot;maxParallelThreads&quot;: $(_HostTestCap), &quot;parallelizeAssembly&quot;: false, &quot;parallelizeTestCollections&quot;: true}' />
  </Target>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- The suite's PostGIS store: one Testcontainers database per test
         process, so no operator sets SPATIAL_POSTGIS_CONNECTION (ADR-0028). -->
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Spatial.Host\Spatial.Host.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Querying\Spatial.Querying.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Contracts\Spatial.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Esri.Codec\Spatial.Esri.Codec.csproj" />
    <ProjectReference Include="..\..\..\clients\dotnet\Spatial.Client\Spatial.Client.csproj" />
    <ProjectReference Include="..\..\..\clients\dotnet\Spatial.Cli\Spatial.Cli.csproj" />
  </ItemGroup>

</Project>
