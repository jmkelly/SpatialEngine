<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Containerised SQL Server integration tests (ADR-0073): drive the
    sqlserver@1 provider against a real SQL Server container (Testcontainers)
    — catalogue, schema discovery, scan/query streaming, canonical batch
    decoding, writing, transactions, cancellation and secrets redaction.
    Tests skip with an explicit reason when the Docker daemon is unavailable
    (Xunit.SkippableFact), so the suite is honest in daemon-less environments
    and runs fully where a container runtime exists.
  -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\..\conformance\Spatial.PredicateConformance\Spatial.PredicateConformance.csproj" />
    <ProjectReference Include="..\..\conformance\Spatial.QueryConformance\Spatial.QueryConformance.csproj" />
    <ProjectReference Include="..\..\conformance\Spatial.WriteConformance\Spatial.WriteConformance.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Querying\Spatial.Querying.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Contracts\Spatial.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Stores.SqlServer\Spatial.Stores.SqlServer.csproj" />
  </ItemGroup>

</Project>
