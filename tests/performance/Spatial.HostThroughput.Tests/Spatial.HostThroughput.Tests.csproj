<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host throughput smoke, suite C (T-077): in-process HttpClient throughput
    against the real host via WebApplicationFactory (no network), asserting
    p95 budgets for query/export/buffer. Opt-in only (SPATIAL_THROUGHPUT=1):
    every test skips in the default gate, exactly like the BenchmarkDotNet
    slice which never executes under `dotnet test`. Run it filtered:

      SPATIAL_THROUGHPUT=1 dotnet test tests/performance/Spatial.HostThroughput.Tests/ -c Release
  -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Spatial.Host\Spatial.Host.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.PluginSdk\Spatial.PluginSdk.csproj" />
    <ProjectReference Include="..\..\..\clients\dotnet\Spatial.Client\Spatial.Client.csproj" />
  </ItemGroup>

</Project>
