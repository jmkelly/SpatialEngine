{"$schema": "qgis-wms-capture-v1", "capture": {"qgisVersion": "4.2.2-Belém do Pará", "qgisVersionShort": "4.2.2", "capturedAt": "2026-09-13", "host": "http://127.0.0.1:5213", "map": "qgis", "driver": "capture.py", "source": "OGC request diagnostics log (commit f670fec): one structured event per request carrying the verbatim parameters"}, "notes": ["QGIS adds a WMS layer with a bare SERVICE=WMS&REQUEST=GetCapabilities (no VERSION).", "QGIS clips the GetMap BBOX to the intersection of the canvas extent with the layer extent and scales WIDTH/HEIGHT to match (full-extent render of a 800x600 canvas became 428x391).", "With the layer negotiated in EPSG:4326, QGIS reprojects a EPSG:3857 canvas client-side and still requests CRS=EPSG:4326; the genuine CRS=EPSG:3857 GetMap needs the layer negotiated in EPSG:3857.", "Identify (Ctrl+Shift+I) issues GetFeatureInfo twice per click: first INFO_FORMAT=application/vnd.ogc.gml (feature results), then INFO_FORMAT=text/html (HTML results). Pixel addressing is I/J (WMS 1.3.0 style).", "QGIS issues NO legend request against this server: the capabilities advertise no LegendURL and the server has no GetLegendGraphic operation (see T-033)."], "seedDatasets": [{"store": "memory", "dataset": "cap.lines", "srid": 4326, "format": "geojson", "body": "{\"type\":\"FeatureCollection\",\"features\":[{\"type\":\"Feature\",\"id\":\"route-a\",\"properties\":{\"name\":\"Route A\"},\"geometry\":{\"type\":\"LineString\",\"coordinates\":[[0,51],[5,53],[10,52]]}},{\"type\":\"Feature\",\"id\":\"route-b\",\"properties\":{\"name\":\"Route B\"},\"geometry\":{\"type\":\"LineString\",\"coordinates\":[[-5,48],[0,50],[4,49]]}}]}"}, {"store": "memory", "dataset": "cap.polys", "srid": 4326, "format": "geojson", "body": "{\"type\":\"FeatureCollection\",\"features\":[{\"type\":\"Feature\",\"id\":\"zone-a\",\"properties\":{\"name\":\"Zone A\"},\"geometry\":{\"type\":\"Polygon\",\"coordinates\":[[[2,50],[8,50],[8,54],[2,54],[2,50]]]}},{\"type\":\"Feature\",\"id\":\"zone-b\",\"properties\":{\"name\":\"Zone B\"},\"geometry\":{\"type\":\"Polygon\",\"coordinates\":[[[-4,46],[2,46],[2,49],[-4,49],[-4,46]]]}}]}"}], "mapLayers": [{"dataset": "demo.cities", "name": "cities", "style": "[{\"type\":\"circle\",\"layout\":{\"visibility\":\"visible\"},\"paint\":{\"circle-color\":\"#ff0000\",\"circle-radius\":8}}]"}, {"dataset": "cap.lines", "store": "memory", "name": "routes", "style": "[{\"type\":\"line\",\"layout\":{\"visibility\":\"visible\"},\"paint\":{\"line-color\":\"#1e88e5\",\"line-width\":2}}]"}, {"dataset": "cap.polys", "store": "memory", "name": "zones", "style": "[{\"type\":\"fill\",\"layout\":{\"visibility\":\"visible\"},\"paint\":{\"fill-color\":\"#2e7d32\",\"fill-opacity\":0.4}}]"}], "requests": [{"name": "add-layer-getcapabilities", "method": "GET", "query": "SERVICE=WMS&REQUEST=GetCapabilities", "expectStatus": 200, "expectMediaType": "application/xml", "expectBodyContains": ["WMS_Capabilities", "cities", "routes", "zones"], "expectBodyAbsent": ["ServiceException"]}, {"name": "getmap-full-extent-4326", "method": "GET", "query": "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&BBOX=40.41680000000000206,-5,59.91389999999999816,16.37379999999999924&CRS=EPSG:4326&WIDTH=428&HEIGHT=391&LAYERS=cities,routes,zones&STYLES=,,&FORMAT=image/png&DPI=96&MAP_RESOLUTION=96&FORMAT_OPTIONS=dpi:96&TRANSPARENT=TRUE", "expectStatus": 200, "expectMediaType": "image/png", "expectPngMagic": true, "expectBodyAbsent": ["ServiceException"]}, {"name": "getmap-zoom-4326", "method": "GET", "query": "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&BBOX=50,0,59.91389999999999816,10&CRS=EPSG:4326&WIDTH=800&HEIGHT=794&LAYERS=cities,routes,zones&STYLES=,,&FORMAT=image/png&DPI=96&MAP_RESOLUTION=96&FORMAT_OPTIONS=dpi:96&TRANSPARENT=TRUE", "expectStatus": 200, "expectMediaType": "image/png", "expectPngMagic": true, "expectBodyAbsent": ["ServiceException"]}, {"name": "getmap-3857", "method": "GET", "query": "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&BBOX=-50000,6000000,950000,7000000&CRS=EPSG:3857&WIDTH=800&HEIGHT=800&LAYERS=cities,routes,zones&STYLES=,,&FORMAT=image/png&DPI=96&MAP_RESOLUTION=96&FORMAT_OPTIONS=dpi:96&TRANSPARENT=TRUE", "expectStatus": 200, "expectMediaType": "image/png", "expectPngMagic": true, "expectBodyAbsent": ["ServiceException"]}, {"name": "identify-point-gml", "method": "GET", "query": "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetFeatureInfo&BBOX=35,-10,60,30&CRS=EPSG:4326&WIDTH=800&HEIGHT=600&LAYERS=cities&STYLES=&FORMAT=image/png&QUERY_LAYERS=cities&INFO_FORMAT=application/vnd.ogc.gml&I=298&J=183&FEATURE_COUNT=10", "expectStatus": 200, "expectMediaType": "application/vnd.ogc.gml", "expectBodyContains": ["Amsterdam"], "expectBodyAbsent": ["ServiceException"]}, {"name": "identify-point-html", "method": "GET", "query": "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetFeatureInfo&BBOX=35,-10,60,30&CRS=EPSG:4326&WIDTH=800&HEIGHT=600&LAYERS=cities&STYLES=&FORMAT=image/png&QUERY_LAYERS=cities&INFO_FORMAT=text/html&I=298&J=183&FEATURE_COUNT=10", "expectStatus": 200, "expectMediaType": "text/html", "expectBodyContains": ["Amsterdam"], "expectBodyAbsent": ["ServiceException"]}, {"name": "identify-line-gml", "method": "GET", "query": "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetFeatureInfo&BBOX=35,-10,60,30&CRS=EPSG:4326&WIDTH=800&HEIGHT=600&LAYERS=routes&STYLES=&FORMAT=image/png&QUERY_LAYERS=routes&INFO_FORMAT=application/vnd.ogc.gml&I=300&J=168&FEATURE_COUNT=10", "expectStatus": 200, "expectMediaType": "application/vnd.ogc.gml", "expectBodyContains": ["Route A"], "expectBodyAbsent": ["ServiceException"]}, {"name": "identify-line-html", "method": "GET", "query": "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetFeatureInfo&BBOX=35,-10,60,30&CRS=EPSG:4326&WIDTH=800&HEIGHT=600&LAYERS=routes&STYLES=&FORMAT=image/png&QUERY_LAYERS=routes&INFO_FORMAT=text/html&I=300&J=168&FEATURE_COUNT=10", "expectStatus": 200, "expectMediaType": "text/html", "expectBodyContains": ["Route A"], "expectBodyAbsent": ["ServiceException"]}, {"name": "identify-polygon-gml", "method": "GET", "query": "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetFeatureInfo&BBOX=35,-10,60,30&CRS=EPSG:4326&WIDTH=800&HEIGHT=600&LAYERS=zones&STYLES=&FORMAT=image/png&QUERY_LAYERS=zones&INFO_FORMAT=application/vnd.ogc.gml&I=300&J=192&FEATURE_COUNT=10", "expectStatus": 200, "expectMediaType": "application/vnd.ogc.gml", "expectBodyContains": ["Zone A"], "expectBodyAbsent": ["ServiceException"]}, {"name": "identify-polygon-html", "method": "GET", "query": "SERVICE=WMS&VERSION=1.3.0&REQUEST=GetFeatureInfo&BBOX=35,-10,60,30&CRS=EPSG:4326&WIDTH=800&HEIGHT=600&LAYERS=zones&STYLES=&FORMAT=image/png&QUERY_LAYERS=zones&INFO_FORMAT=text/html&I=300&J=192&FEATURE_COUNT=10", "expectStatus": 200, "expectMediaType": "text/html", "expectBodyContains": ["Zone A"], "expectBodyAbsent": ["ServiceException"]}]}