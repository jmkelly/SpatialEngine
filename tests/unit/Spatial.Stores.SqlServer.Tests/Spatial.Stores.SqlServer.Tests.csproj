<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the SQL Server provider's private adapters (ADR-0072): the
    WKB interchange, schema discovery, row mapping, the filter language,
    SQL generation, secrets redaction and argument validation — all DB-free
    (the containerised integration suite in tests/integration covers the
    real SQL Server path).
  -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Contracts\Spatial.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Stores.SqlServer\Spatial.Stores.SqlServer.csproj" />
  </ItemGroup>

</Project>
