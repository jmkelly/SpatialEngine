    spike's libvips traps (sRGB interpretation, equal band counts,
    premultiplied input, stride) plus read/compose/encode behaviour and
    formatting regressions, with no external imagery fixture.
  -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Contracts\Spatial.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Imagery.Vips\Spatial.Imagery.Vips.csproj" />
  </ItemGroup>

</Project>
