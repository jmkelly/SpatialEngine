<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The plugin package packer: assembles immutable worker packages (manifest +
    provider + contracts DLLs) into a packages root for the Spatial.Host
    process supervisor. This is the build-time tool that turns provider
    assemblies into deployable packages (plan §10/§15, ADR-0006/0025); the
    host itself never references plugin assemblies (architecture guard).
    Lives outside src/tests on purpose — build it explicitly in
    eng/e2e-web.sh; it is not part of the solution.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Spatial.PluginPacker</AssemblyName>
    <RootNamespace>Spatial.PluginPacker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.PluginSdk\Spatial.PluginSdk.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.PluginHost.DotNet\Spatial.PluginHost.DotNet.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Operations.NetTopologySuite\Spatial.Operations.NetTopologySuite.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Provider.Demo\Spatial.Provider.Demo.csproj" />
    <ProjectReference Include="..\..\..\src\Spatial.Provider.PostGIS\Spatial.Provider.PostGIS.csproj" />
  </ItemGroup>

</Project>