<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The GeoServices REST serving boundary (ADR-0035: the server side): a boundary
    adapter that maps the Esri GeoServices REST specification onto the in-process
    engine services. It contains no spatial algorithms — the adapter maps protocol
    to verbs and delegates to IGeometryOperations, ICoordinateTransforms and
    the keyed stores. ASP.NET Core types stay inside this project; the adapter
    is mounted by Spatial.Host only. The consuming side is the
    Spatial.Stores.ArcGisRest client; both share only Spatial.Esri.Codec.
  -->

  <PropertyGroup>
    <AssemblyName>Spatial.Adapter.GeoServices</AssemblyName>
    <RootNamespace>Spatial.Adapter.GeoServices</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\Spatial.Contracts\Spatial.Contracts.csproj" />
    <ProjectReference Include="..\Spatial.Esri.Codec\Spatial.Esri.Codec.csproj" />
    <ProjectReference Include="..\Spatial.Ingest.Codec\Spatial.Ingest.Codec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spatial.Adapter.GeoServices.Tests" />
    <InternalsVisibleTo Include="Spatial.Host.Tests" />
  </ItemGroup>

</Project>
