<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Foreign-format ingest codecs (ADR-0041): GeoJSON, newline-delimited
    GeoJSON and CSV decoded into canonical FeatureBatch pages. References
    Spatial.Core only — no algorithms, no ASP.NET, no HttpClient. Upload
    bodies are opaque bytes in a declared format; this project is the single
    place foreign file JSON/text shapes live, and nothing here crosses a
    contract as JSON geometry.
  -->

  <PropertyGroup>
    <AssemblyName>Spatial.Interop.Ingest</AssemblyName>
    <RootNamespace>Spatial.Interop.Ingest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spatial.Core\Spatial.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spatial.Interop.Ingest.Tests" />
  </ItemGroup>

</Project>
