<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The PostGIS data store (ADR-0033, ADR-0010): the in-process
    implementation of IDataCatalogue, IFeatureStore and ITransactionStore on
    Npgsql 10, linked by Spatial.Host. Connection secrets come from host
    configuration (PostgisOptions). Npgsql types, SQL and EWKB live inside
    this package's private adapters (ADR-0005) and never cross a public
    boundary.
  -->

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\Spatial.PluginSdk\Spatial.PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests pin the private adapters' conversion and validation behaviour. -->
    <InternalsVisibleTo Include="Spatial.Stores.PostGIS.Tests" />
    <InternalsVisibleTo Include="Spatial.PostGIS.Tests" />
  </ItemGroup>

</Project>