<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The NetTopologySuite geometry service (ADR-0033): the in-process
    implementation of IGeometryOperations (buffer, intersection, validation,
    simplify) on top of NetTopologySuite, linked by Spatial.Host. NTS types
    live inside this package's private adapters (ADR-0005) and never cross a
    public boundary.
  -->

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\Spatial.Contracts\Spatial.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests pin the private adapter's conversion behaviour. -->
    <InternalsVisibleTo Include="Spatial.Operations.NetTopologySuite.Tests" />
  </ItemGroup>

</Project>