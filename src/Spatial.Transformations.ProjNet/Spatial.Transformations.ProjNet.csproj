<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ProjNet coordinate service (ADR-0033): the in-process implementation
    of ICrsDirectory and ICoordinateTransforms on top of ProjNet 2.1 (the
    NetTopologySuite-team continuation of PROJ.NET), linked by Spatial.Host.
    ProjNet types live inside this package's private adapters and catalogue
    (ADR-0005) and never cross a public boundary.
  -->

  <ItemGroup>
    <PackageReference Include="ProjNET" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\Spatial.Contracts\Spatial.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests pin the private adapters' conversion behaviour. -->
    <InternalsVisibleTo Include="Spatial.Transformations.ProjNet.Tests" />
  </ItemGroup>

</Project>