<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ArcGIS REST consuming client (ADR-0035: the client side): an in-process
    keyed store implementing IDataCatalogue and IFeatureStore over a configured
    ArcGIS REST FeatureServer or MapServer URL. It converts Esri JSON to core
    values inside the store and pushes down the supported query subset.
    Esri wire types stay in Spatial.Esri.Codec; HttpClient types stay
    inside this assembly (ADR-0005).
  -->

  <PropertyGroup>
    <AssemblyName>Spatial.Stores.ArcGisRest</AssemblyName>
    <RootNamespace>Spatial.Stores.ArcGisRest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\Spatial.Contracts\Spatial.Contracts.csproj" />
    <ProjectReference Include="..\Spatial.Esri.Codec\Spatial.Esri.Codec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spatial.Stores.ArcGisRest.Tests" />
  </ItemGroup>

</Project>
