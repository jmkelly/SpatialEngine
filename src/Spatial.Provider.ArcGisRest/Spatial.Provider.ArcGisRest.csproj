<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The ArcGIS REST consuming provider (ADR-0035): an in-process
    implementation of IDataCatalogue and IFeatureStore over a configured
    ArcGIS REST FeatureServer or MapServer URL. It converts Esri JSON to core
    values inside the provider and pushes down the supported query subset.
    Esri wire types stay in Spatial.Interop.Esri; HttpClient types stay
    inside this assembly (ADR-0005).
  -->

  <PropertyGroup>
    <AssemblyName>Spatial.Provider.ArcGisRest</AssemblyName>
    <RootNamespace>Spatial.Provider.ArcGisRest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spatial.Core\Spatial.Core.csproj" />
    <ProjectReference Include="..\Spatial.PluginSdk\Spatial.PluginSdk.csproj" />
    <ProjectReference Include="..\Spatial.Interop.Esri\Spatial.Interop.Esri.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spatial.Provider.ArcGisRest.Tests" />
  </ItemGroup>

</Project>
