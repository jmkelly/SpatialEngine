{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spatial": {
    "Postgis": {
      "ConnectionString": ""
    },
    "Admin": {
      "Token": ""
    },
    "Publications": {
      "Path": "./data/publications.json"
    },
    "Ingest": {
      "MaxBytes": 104857600,
      "MaxFeatures": 1000000,
      "Formats": [ "geojson", "ndjson", "csv" ]
    },
    "GeoServices": {
      "Root": "/arcgis/rest/services",
      "AdminRoot": "/arcgis/admin",
      "Services": [
        {
          "Name": "demo",
          "Store": "demo",
          "Type": "FeatureServer"
        }
      ]
    }
  }
}
