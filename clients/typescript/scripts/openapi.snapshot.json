  "components": {
    "schemas": {
      "AxisOrientation": {
        "enum": [
          "east",
          "north",
          "west",
          "south",
          "up",
          "down",
          "other"
        ]
      },
      "BboxDto": {
        "required": [
          "minX",
          "minY",
          "maxX",
          "maxY"
        ],
        "type": "object",
        "properties": {
          "minX": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "minY": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "maxX": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "maxY": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "BeginTransactionResponse": {
        "required": [
          "transaction"
        ],
        "type": "object",
        "properties": {
          "transaction": {
            "type": "string"
          }
        }
      },
      "BufferRequest": {
        "required": [
          "geometry",
          "distance"
        ],
        "type": "object",
        "properties": {
          "geometry": {
            "type": "string"
          },
          "distance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quadrantSegments": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 8
          }
        }
      },
      "CatalogueResponse": {
        "required": [
          "datasets"
        ],
        "type": "object",
        "properties": {
          "datasets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DatasetSummary"
            }
          }
        }
      },
      "CreateDatasetRequest": {
        "required": [
          "dataset",
          "batch",
          "srid"
        ],
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string"
          },
          "batch": {
            "type": "string"
          },
          "srid": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateDatasetResponse": {
        "required": [
          "dataset"
        ],
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string"
          }
        }
      },
      "CrsAxis": {
        "required": [
          "name",
          "orientation",
          "unitName"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "orientation": {
            "$ref": "#/components/schemas/AxisOrientation"
          },
          "unitName": {
            "type": "string"
          }
        }
      },
      "CrsDescription": {
        "required": [
          "authority",
          "code",
          "name",
          "kind",
          "dimension",
          "axes",
          "datum",
          "ellipsoid"
        ],
        "type": "object",
        "properties": {
          "authority": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/CrsKind"
          },
          "dimension": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "axes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CrsAxis"
            }
          },
          "datum": {
            "type": [
              "null",
              "string"
            ]
          },
          "ellipsoid": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CrsEllipsoid"
              }
            ]
          }
        }
      },
      "CrsEllipsoid": {
        "required": [
          "name",
          "semiMajorAxis",
          "semiMinorAxis",
          "unitName"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "semiMajorAxis": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "semiMinorAxis": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "unitName": {
            "type": "string"
          }
        }
      },
      "CrsKind": {
        "enum": [
          "geographic",
          "projected",
          "geocentric",
          "vertical",
          "compound",
          "other"
        ]
      },
      "DatasetDescription": {
        "required": [
          "id",
          "schemaName",
          "table",
          "geometryColumn",
          "srid",
          "geometryType",
          "estimatedRowCount",
          "idColumns",
          "schema"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "schemaName": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "geometryColumn": {
            "type": "string"
          },
          "srid": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "geometryType": {
            "type": "string"
          },
          "estimatedRowCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "idColumns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "schema": {
            "$ref": "#/components/schemas/FeatureSchema"
          }
        }
      },
      "DatasetSummary": {
        "required": [
          "id",
          "schema",
          "table",
          "geometryColumn",
          "srid",
          "estimatedRowCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "geometryColumn": {
            "type": "string"
          },
          "srid": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "estimatedRowCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "DescribeRequest": {
        "required": [
          "crs"
        ],
        "type": "object",
        "properties": {
          "crs": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FeatureBatchesResponse": {
        "required": [
          "batches"
        ],
        "type": "object",
        "properties": {
          "batches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "FeatureQueryRequest": {
        "required": [
          "dataset"
        ],
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string"
          },
          "bbox": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BboxDto"
              }
            ]
          },
          "filter": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FeatureSchema": { },
      "FeatureWriteRequest": {
        "required": [
          "dataset",
          "batch"
        ],
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string"
          },
          "batch": {
            "type": "string"
          },
          "transaction": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FeatureWriteResponse": {
        "required": [
          "appended"
        ],
        "type": "object",
        "properties": {
          "appended": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "GeometryResponse": {
        "required": [
          "geometry"
        ],
        "type": "object",
        "properties": {
          "geometry": {
            "type": "string"
          }
        }
      },
      "IntersectionRequest": {
        "required": [
          "left",
          "right"
        ],
        "type": "object",
        "properties": {
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          }
        }
      },
      "ScanRequest": {
        "required": [
          "dataset"
        ],
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string"
          }
        }
