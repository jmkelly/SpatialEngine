{
  "name": "@spatial/client",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Spatial Engine public host API. Talks only the public HTTP contracts; no renderer dependencies.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate.mjs scripts/openapi.snapshot.json src/generated-types.ts",
    "check:generated": "node scripts/check-generated.mjs",
    "test": "npm run typecheck && npm run check:generated && node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e.test.ts test/geoservices-e2e.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@esri/arcgis-rest-feature-service": "^4.11.0",
    "@esri/arcgis-rest-request": "^4.11.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
